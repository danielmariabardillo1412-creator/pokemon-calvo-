extends SceneTree
# W04 V6: validates the real post-settlement consumer contract and prompt UI.
# XP events generated by ProgressionSystem; this is NOT a native Showdown battle.
const Overlay = preload("res://modules/creatures/progression/pokemon_variant_catalog.gd")
const Consumer = preload("res://modules/gameplay/w04_postbattle_evolution_consumer_v6.gd")
const Presentation = preload("res://scenes/visual/field_native_presentation.gd")
const ROUTES := [
    [&"diglett_alola", &"dugtrio_alola", 26],
    [&"meowth_galar", &"perrserker", 28],
]
var failures: Array[String] = []
var checks := 0
var accepted := 0
var declined := 0

func _initialize() -> void: call_deferred("_run")
func check(ok: bool, label: String) -> void:
    checks += 1
    if not ok: failures.append(label); push_error("W04_V6_FAIL " + label)

func creature(catalog: DefinitionCatalog, sid: StringName, id: StringName, lvl: int) -> CreatureInstance:
    var rng := RandomNumberGenerator.new()
    rng.seed = 20261112
    return CreatureFactory.create(catalog.species(sid), lvl, catalog, ProgressionRuleset.new(), rng,
        {"instance_id": id, "nature_id": &"hardy", "moves": [&"tackle"]})

func event_for(events: Array, target: StringName) -> ProgressionEvent:
    for row in events:
        if row is ProgressionEvent and row.kind == ProgressionEvent.EVOLUTION_AVAILABLE                 and StringName(row.data.get("species_id", "")) == target: return row
    return null

func case(catalog: DefinitionCatalog, source: StringName, target: StringName,
        lvl: int, stored: bool, accept: bool) -> void:
    var tag := String(source) + ("_storage" if stored else "_party") + ("_accept" if accept else "_decline")
    var rules := ProgressionRuleset.new()
    var owner := PlayerCollection.new()
    var mon := creature(catalog, source, StringName("w04_v6_" + tag), lvl - 1)
    check(mon != null and mon.form_id != &"", tag + "_valid_source")
    if mon == null: return
    mon.effective_nature_id = &"adamant"
    mon.recalculate_stats(catalog.species(source), rules)
    if not mon.moveset.is_empty(): mon.moveset[0].current_pp = maxi(0, mon.moveset[0].max_pp - 1)
    check(owner.party.add_creature(mon), tag + "_owned")
    if stored: check(owner.deposit(mon.instance_id), tag + "_in_storage")
    var old_location := owner.location_of(mon.instance_id)
    var xp: int = rules.experience_for_level(catalog.species(source).growth_rate, lvl) - mon.experience
    var ev: ProgressionEvent = event_for(ProgressionSystem.gain_experience(mon, xp, catalog.species(source), catalog, rules), target)
    check(ev != null and mon.level == lvl, tag + "_real_xp_event")
    if ev == null: return
    var proof: Dictionary = Consumer.eligible(owner, catalog, ev)
    check(proof.get("ok", false), tag + "_eligible")
    var previous := mon.to_dict()
    var wrong := ProgressionEvent.new(ProgressionEvent.EVOLUTION_AVAILABLE, mon.instance_id,
        {"species_id": "pikachu", "min_level": lvl})
    check(not Consumer.eligible(owner, catalog, wrong).get("ok", false), tag + "_wrong_target")
    var tampered := proof.duplicate()
    tampered["source_level"] = 1
    check(not Consumer.decide(owner, catalog, rules, ev, tampered, true).get("accepted", false),
        tag + "_tampered_prompt")
    check(owner.owned_creature(mon.instance_id) == mon, tag + "_untouched_before_choice")
    var response := Consumer.decide(owner, catalog, rules, ev, proof, accept)
    check(response.get("accepted", false) and bool(response.get("evolved", false)) == accept,
        tag + "_decision_recorded")
    var resulting: CreatureInstance = owner.owned_creature(mon.instance_id)
    check(owner.location_of(mon.instance_id) == old_location and resulting != null,
        tag + "_owner_location")
    if resulting == null: return
    if accept:
        accepted += 1
        check(resulting != mon and resulting.species_id == target and resulting.instance_id == mon.instance_id,
            tag + "_same_identity")
        check(resulting.nature_id == mon.nature_id and resulting.effective_nature_id == &"adamant"
            and resulting.ivs == mon.ivs and resulting.evs == mon.evs and resulting.experience == mon.experience,
            tag + "_persistent_metadata")
        check(resulting.to_dict().get("moveset", []) == previous.get("moveset", []),
            tag + "_preserved_pp")
        check(resulting.stats.to_dict() == StatCalculator.compute(catalog.species(target).base_stat_block(),
            resulting.ivs, resulting.evs, resulting.effective_nature_id, resulting.level).to_dict(),
            tag + "_effective_stats")
        check(resulting.form_id != mon.form_id, tag + "_not_inherit_form")
        check(not Consumer.eligible(owner, catalog, ev).get("ok", false),
            tag + "_no_repeat_prompt_after_evolution")
    else:
        declined += 1
        check(resulting == mon and resulting.to_dict() == previous,
            tag + "_decline_leaves_exact_mon")
    var path := "user://w04_v6_" + tag + ".json"
    var repo := SaveGameRepository.new()
    check(repo.save_collection(path, owner).ok, tag + "_save")
    var restored := repo.load(path)
    check(restored.ok, tag + "_load")
    if restored.ok:
        var load_mon: CreatureInstance = restored.storage.get_creature(mon.instance_id) if stored else restored.party.get_creature(mon.instance_id)
        check(load_mon != null and load_mon.to_dict() == resulting.to_dict(),
            tag + "_savev2_roundtrip")
    DirAccess.remove_absolute(ProjectSettings.globalize_path(path))

func guards(catalog: DefinitionCatalog) -> void:
    var rules := ProgressionRuleset.new()
    var owner := PlayerCollection.new()
    var mon := creature(catalog, &"diglett_alola", &"w04_v6_everstone", 25)
    owner.party.add_creature(mon)
    mon.held_item_id = &"everstone"
    var xp := rules.experience_for_level(catalog.species(mon.species_id).growth_rate, 26) - mon.experience
    var events := ProgressionSystem.gain_experience(mon, xp, catalog.species(mon.species_id), catalog, rules)
    check(event_for(events, &"dugtrio_alola") == null, "everstone_no_event")
    var fake := ProgressionEvent.new(ProgressionEvent.EVOLUTION_AVAILABLE, mon.instance_id,
        {"species_id": "dugtrio_alola", "min_level": 26})
    check(not Consumer.eligible(owner, catalog, fake).get("ok", false),
        "everstone_forged_event_denied")
    mon.held_item_id = &""
    check(not Consumer.eligible(owner, catalog,
        ProgressionEvent.new(ProgressionEvent.EVOLUTION_AVAILABLE, &"not_owned",
        {"species_id": "dugtrio_alola", "min_level": 26})).get("ok", false),
        "not_owned_denied")

func _run() -> void:
    var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(Overlay.CANONICAL))
    check(parsed is Dictionary, "canonical")
    if not parsed is Dictionary: finish(); return
    var catalog: DefinitionCatalog = GameData.from_dict(parsed).to_definition_catalog()
    check(Overlay.apply(catalog), "regional_overlay")
    for row in ROUTES:
        for stored in [false, true]:
            for accept in [false, true]:
                case(catalog, row[0], row[1], row[2], stored, accept)
    guards(catalog)
    # Instantiate the exact field-native visual evolution prompt, not an
    # artificial rewritten button. The native battle itself is not driven here.
    var view: Control = Presentation.new()
    view.catalogs = catalog
    get_root().add_child(view)
    await process_frame
    check(view._evolution_choices_w04 != null, "real_field_choice_widget_present")
    check(view.has_pending_evolution_w04() == false, "no_phantom_pending_at_start")
    view.queue_free()
    finish()

func finish() -> void:
    if failures.is_empty() and accepted == 4 and declined == 4:
        print("W04_V6_CONSUMER PASS checks=", checks, " pilots=2 accepted=4 declined=4")
        quit(0)
    else:
        print("W04_V6_CONSUMER FAIL errors=", JSON.stringify(failures))
        quit(1)
