  "r1_r7": [
    {
      "id": "R1",
      "finding": "Map stopped loading: field_demo used a nonexistent session API and the wrong party collection.",
      "fix": "field_demo reads the leader from _session.player.party with the real type; no nonexistent API remains.",
      "verification": "The map scene instantiates, opens the field bag, equips Smoke Ball and captures it in the O120 GPU group; the closure runner also boots the map regression."
    },
    {
      "id": "R2",
      "finding": "O110 had no real native effects; tests asserted constants.",
      "fix": "native_bag_effects.cjs applies boost/Focus Energy/Mist/status cures with native simulator APIs and applyMedicine routes the 11 reviewed IDs.",
      "verification": "Node native row probe plus Godot bag/medicine/GPU groups; 13,274 family checks."
    },
    {
      "id": "R3",
      "finding": "Consumption and rejection semantics were not verified.",
      "fix": "One unit is spent only on an applied effect; rejection mutates nothing, draws no RNG and spends nothing; flutes are reusable.",
      "verification": "Accept/reject, cap, repeated-use, enemy/residual/KO, prepare/abort/commit, save/load and checkpoint roster tests."
    },
    {
      "id": "R4",
      "finding": "O120 items were not connected to the Run boundary or encounter preparation.",
      "fix": "held_escape_items.gd is called by flee() with native held_item_active; encounter_item_modifiers.gd is called by field_prepare_native_encounter and wild_adventure_session.",
      "verification": "Smoke Ball slow/fast/trapped/suppressed/consumed cases, encounter-rate table copy, save/load and two GPU captures; 1,606 family checks."
    },
    {
      "id": "R5",
      "finding": "Verifiers were placeholders or did not execute the implementation.",
      "fix": "Placeholders replaced with tests that call the real code and assert concrete effects.",
      "verification": "14,880 family checks and 1,285 closure checks in the final run, all with nonzero counts."
    },
    {
      "id": "R6",
      "finding": "Audit was incomplete and had unreviewed UNKNOWN rows.",
      "fix": "Audit v2 separates permission/art/equip/native/field/battle/evolution/machine/scenario/overall and explains every dependency.",
      "verification": "2,222 rows, UNKNOWN=0, 10 real tests and byte-for-byte --check."
    },
    {
      "id": "R7",
      "finding": "FINAL_RESULTS.json did not parse and its hashes did not match real files.",
      "fix": "Final evidence is serialized from the actual reports and logs; SHA-256 is computed over the real files.",
      "verification": "This file, the family evidence, the closure report hashes and the standalone guard log."
    }
  ],
